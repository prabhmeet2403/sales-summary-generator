# Local development template -- copy this file to `.env` and fill in
# real values for local testing only.
#
# NEVER commit a real `.env` file (it's already excluded via
# .gitignore). On Render, do not use a .env file at all -- set these
# same three variables as real Environment Variables in the Render
# dashboard (Service -> Environment), or via `render.yaml`'s envVars
# with `sync: false` (already configured that way in this repo). app.py
# calls load_dotenv() on startup, which is a no-op in production once
# these are real environment variables -- it never overrides a
# variable that's already set.

BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_BEARER_TOKEN_BEDROCK=replace-with-a-real-bedrock-bearer-token
